# Copie para .env e preencha. Nunca versione o .env.

# Chave para assinar o cookie de sessão. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Credenciais da API do Telegram (https://my.telegram.org > API development tools)
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# Bot que envia os avisos (crie com @BotFather) e o chat que recebe
BOT_TOKEN=123456:ABC-DEF
CHAT_ID=123456789

# Opcionais
# DATA_DIR=data            # onde ficam o banco e a sessão do Telethon
# COOKIE_SECURE=false      # true quando servido por HTTPS
# SESSION_DAYS=30
# TIMEZONE=America/Sao_Paulo   # fuso usado nas datas do painel

# Mercado Livre (opcional): app criado em https://developers.mercadolivre.com.br
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=
